// This is your Prisma schema file
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
}

model Genre {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  books Book[]
}

model Book {
  id              String   @id @default(cuid())
  title           String
  author          String
  isbn            String   @unique
  genreId         String
  genre           Genre    @relation(fields: [genreId], references: [id])
  totalCopies     Int
  availableCopies Int
  createdAt       DateTime @default(now())
}
